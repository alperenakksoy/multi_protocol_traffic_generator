# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in the IPs for your setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── 2-Machine setup (Machine A + Machine B) ───────────────────────────────
# On Machine A: docker-compose -f docker-compose.generators.yml up --build
TARGET_B_IP=192.168.1.42

# ── 3-Machine setup (Machine A1 + Machine A2 + Machine B) ─────────────────
# On Machine A1: docker-compose -f docker-compose.generators.yml up controller dashboard gen-http2 gen-quic
# On Machine A2: docker-compose -f docker-compose.generators2.yml up --build  (uses its own .env with TARGET_B_IP)
#
# Uncomment on Machine A1:
# TARGET_B_IP=192.168.1.42
# GEN_MQTT_HOST=192.168.1.43
# GEN_TCPUDP_HOST=192.168.1.43
